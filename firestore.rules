rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir a usuarios autenticados (incluso de forma anónima) gestionar su información y dispositivos
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /devices/{deviceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Permitir registrar nuevos clientes para el conteo de la alerta de las 8:30 PM
    match /clientRegistrations/{regId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
    }

    // Colección de dispositivos consultable por Cloud Functions para el envío push
    match /{path=**}/devices/{device} {
      allow read: if request.auth != null;
    }
  }
}
